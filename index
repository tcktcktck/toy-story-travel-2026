<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toy Story Travel - Pro Sync</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

  <script>
    tailwind.config = {
      theme: { extend: { colors: { toyBlue: '#2A75B3', toyYellow: '#F1C40F', toyRed: '#E74C3C', toyGreen: '#2ECC71', toyPurple: '#9B59B6', toyWoody: '#F39C12', toyPink: '#FFB6C1' }}}
    }
  </script>
  
  <style type="text/tailwindcss">
    @layer components {
      .card-toy { @apply bg-white rounded-[2.5rem] p-5 shadow-xl border-b-[8px] border-slate-200 h-[calc(100vh-230px)] overflow-y-auto relative; }
      .nav-item { @apply flex flex-col items-center cursor-pointer transition-all duration-300 text-slate-300 flex-1; }
      .nav-item.active { @apply text-toyBlue scale-110; }
      .edit-input { @apply w-full p-2 mb-2 border-2 border-dashed border-slate-200 rounded-xl outline-none text-sm font-bold bg-blue-50/50; }
      .header-font { font-family: 'Arial Black', sans-serif; text-shadow: 2px 2px #E74C3C; }
    }
    body { background-color: #E0F2FE; background-image: radial-gradient(#fff 10%, transparent 10%); background-size: 30px 30px; }
    [v-cloak] { display: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="h-screen overflow-hidden">

  <div id="app" class="h-full flex flex-col" v-cloak>
    <header class="bg-toyBlue p-4 text-white text-center shadow-lg border-b-[6px] border-toyYellow shrink-0 relative z-50">
      <h1 class="text-2xl font-black italic tracking-tighter uppercase header-font">Toy Story Travel</h1>
      <div v-if="loading" class="absolute right-4 top-6 text-[9px] animate-pulse">📡 SYNC...</div>
    </header>

    <div class="swiper mySwiper flex-1 w-full pt-2">
      <div class="swiper-wrapper">
        
        <div class="swiper-slide px-4">
          <div class="card-toy border-l-[12px] border-toyYellow">
            <div class="flex justify-between items-start sticky top-0 bg-white z-20 pb-2 border-b mb-2">
              <h2 class="text-xl font-black text-toyYellow">行程</h2>
              <button @click="toggleEdit('itinerary')">
                <i :class="isEditing.itinerary ? 'fas fa-check-circle text-toyGreen text-2xl' : 'fas fa-edit text-slate-200 text-xl'"></i>
              </button>
            </div>
            <div v-if="isEditing.itinerary" class="space-y-2">
               <div v-for="(item, idx) in travelData.itinerary" class="p-3 bg-slate-50 rounded-xl relative">
                  <input v-model="item.time" class="edit-input w-20">
                  <input v-model="item.activity" class="edit-input">
                  <button @click="travelData.itinerary.splice(idx, 1)" class="absolute -top-1 -right-1 text-toyRed">✕</button>
               </div>
               <button @click="travelData.itinerary.push({time:'00:00',activity:''})" class="w-full py-2 border-2 border-dashed border-toyYellow rounded-xl text-xs">+ 新增</button>
            </div>
            <div v-else v-for="item in travelData.itinerary" class="flex gap-4 p-3 border-b border-slate-50">
              <span class="text-toyWoody font-black text-xs">{{item.time}}</span>
              <p class="font-bold text-sm">{{item.activity}}</p>
            </div>
          </div>
        </div>

        <div class="swiper-slide px-4">
          <div class="card-toy border-l-[12px] border-toyBlue">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
              <h2 class="text-xl font-black text-toyBlue">地圖備註</h2>
              <button @click="toggleEdit('map')"><i :class="isEditing.map ? 'fas fa-check-circle text-toyGreen text-2xl' : 'fas fa-edit text-slate-200 text-xl'"></i></button>
            </div>
            <div v-if="isEditing.map">
              <textarea v-model="travelData.mapNotes" class="edit-input h-48" placeholder="輸入地點座標或交通貼士..."></textarea>
            </div>
            <div v-else class="text-sm font-bold text-slate-600 whitespace-pre-line">{{travelData.mapNotes}}</div>
          </div>
        </div>

        <div class="swiper-slide px-4">
          <div class="card-toy border-l-[12px] border-toyPurple">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
              <h2 class="text-xl font-black text-toyPurple">航班</h2>
              <button @click="toggleEdit('flight')"><i :class="isEditing.flight ? 'fas fa-check-circle text-toyGreen text-2xl' : 'fas fa-edit text-slate-200 text-xl'"></i></button>
            </div>
            <div v-if="isEditing.flight">
              <input v-model="travelData.flight.no" class="edit-input">
              <input v-model="travelData.flight.gate" class="edit-input" placeholder="登機閘口">
            </div>
            <div v-else class="bg-purple-50 p-6 rounded-3xl text-center">
              <p class="text-4xl font-black">{{travelData.flight.no}}</p>
              <p class="mt-4 text-toyPurple font-bold">Gate: {{travelData.flight.gate || 'TBC'}}</p>
            </div>
          </div>
        </div>

        <div class="swiper-slide px-4">
          <div class="card-toy border-l-[12px] border-toyGreen">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
              <h2 class="text-xl font-black text-toyGreen">酒店</h2>
              <button @click="toggleEdit('hotel')"><i :class="isEditing.hotel ? 'fas fa-check-circle text-toyGreen text-2xl' : 'fas fa-edit text-slate-200 text-xl'"></i></button>
            </div>
            <div v-if="isEditing.hotel">
              <textarea v-model="travelData.hotelInfo" class="edit-input h-40"></textarea>
            </div>
            <div v-else class="font-bold text-sm whitespace-pre-line">{{travelData.hotelInfo}}</div>
          </div>
        </div>

        <div class="swiper-slide px-4">
          <div class="card-toy border-l-[12px] border-toyWoody">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
              <h2 class="text-xl font-black text-toyWoody">行李</h2>
              <button @click="toggleEdit('packing')"><i :class="isEditing.packing ? 'fas fa-check-circle text-toyGreen text-2xl' : 'fas fa-edit text-slate-200 text-xl'"></i></button>
            </div>
            <div v-if="isEditing.packing" class="space-y-2">
              <div v-for="(item, idx) in travelData.packing" class="flex gap-2">
                <input v-model="item.name" class="edit-input">
                <button @click="travelData.packing.splice(idx, 1)" class="text-toyRed">✕</button>
              </div>
              <button @click="travelData.packing.push({name:'',done:false})" class="w-full py-2 border-2 border-dashed border-toyWoody rounded-xl text-xs">+ 新增物品</button>
            </div>
            <div v-else v-for="item in travelData.packing" @click="item.done = !item.done; saveToFirebase()" class="flex items-center gap-3 p-3 border-b cursor-pointer">
              <i :class="item.done ? 'fas fa-check-circle text-toyGreen' : 'far fa-circle text-slate-200'"></i>
              <span :class="{'line-through text-slate-300': item.done}" class="font-bold text-sm">{{item.name}}</span>
            </div>
          </div>
        </div>

        <div class="swiper-slide px-4">
          <div class="card-toy border-l-[12px] border-toyPink">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
              <h2 class="text-xl font-black text-toyPink">預算</h2>
              <button @click="toggleEdit('expense')"><i :class="isEditing.expense ? 'fas fa-check-circle text-toyGreen text-2xl' : 'fas fa-edit text-slate-200 text-xl'"></i></button>
            </div>
            <div v-if="isEditing.expense" class="space-y-2">
              <div v-for="(item, idx) in travelData.expenses" class="flex gap-2">
                <input v-model="item.name" class="edit-input">
                <input v-model.number="item.cost" class="edit-input w-24" type="number">
              </div>
              <button @click="travelData.expenses.push({name:'',cost:0})" class="w-full py-2 border-2 border-dashed border-toyPink rounded-xl text-xs">+ 新增支出</button>
            </div>
            <div v-else>
              <div v-for="item in travelData.expenses" class="flex justify-between p-3 border-b text-sm font-bold">
                <span>{{item.name}}</span><span class="text-toyPink">£{{item.cost}}</span>
              </div>
              <div class="mt-4 p-3 bg-pink-50 rounded-xl flex justify-between font-black text-toyPink">
                <span>TOTAL</span><span>£{{ travelData.expenses.reduce((s, e) => s + e.cost, 0) }}</span>
              </div>
            </div>
          </div>
        </div>

      </div>
      <div class="swiper-pagination !bottom-2"></div>
    </div>

    <nav class="bg-white h-20 flex justify-around items-center border-t shrink-0 pb-2 z-50">
      <div @click="goTo(0)" :class="{active: activeIdx === 0}" class="nav-item"><i class="fas fa-calendar-alt text-xl"></i><span class="text-[9px] font-black mt-1">行程</span></div>
      <div @click="goTo(1)" :class="{active: activeIdx === 1}" class="nav-item"><i class="fas fa-map-location-dot text-xl"></i><span class="text-[9px] font-black mt-1">地圖</span></div>
      <div @click="goTo(2)" :class="{active: activeIdx === 2}" class="nav-item"><i class="fas fa-plane text-xl"></i><span class="text-[9px] font-black mt-1">航班</span></div>
      <div @click="goTo(3)" :class="{active: activeIdx === 3}" class="nav-item"><i class="fas fa-hotel text-xl"></i><span class="text-[9px] font-black mt-1">酒店</span></div>
      <div @click="goTo(4)" :class="{active: activeIdx === 4}" class="nav-item"><i class="fas fa-suitcase text-xl"></i><span class="text-[9px] font-black mt-1">行李</span></div>
      <div @click="goTo(5)" :class="{active: activeIdx === 5}" class="nav-item"><i class="fas fa-piggy-bank text-xl"></i><span class="text-[9px] font-black mt-1">記帳</span></div>
    </nav>
  </div>

  <script>
    const { createApp, ref, onMounted } = Vue
    const firebaseConfig = {
      apiKey: "AIzaSyA9rkD3I-5PX7Gszl41SlPCYALIeil2mkA",
      authDomain: "toystorytravel.firebaseapp.com",
      projectId: "toystorytravel",
      databaseURL: "https://toystorytravel-default-rtdb.firebaseio.com/" 
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    createApp({
      setup() {
        const swiperRef = ref(null);
        const activeIdx = ref(0);
        const loading = ref(true);
        const isEditing = ref({ itinerary:false, map:false, flight:false, hotel:false, packing:false, expense:false });

        const travelData = ref({
          itinerary: [{time:'09:45', activity:'Anfield Stadium Tour'}],
          mapNotes: 'Elizabeth Line: £15.50\nBus: £1.75',
          flight: { no: 'BA8089', gate: '' },
          hotelInfo: 'Belzan Dinner at 20:00',
          packing: [{ name: 'Passport', done: true }],
          expenses: [{ name: 'Flight', cost: 800 }]
        });

        const loadFirebase = () => {
          db.ref('travelData').on('value', (s) => {
            if (s.val()) travelData.value = s.val();
            loading.value = false;
          });
        };

        const saveToFirebase = () => {
          loading.value = true;
          db.ref('travelData').set(travelData.value).then(() => loading.value = false);
        };

        const toggleEdit = (part) => {
          isEditing.value[part] = !isEditing.value[part];
          if (!isEditing.value[part]) saveToFirebase();
        };

        const goTo = (idx) => { swiperRef.value.slideTo(idx); activeIdx.value = idx; };

        onMounted(() => {
          loadFirebase();
          swiperRef.value = new Swiper(".mySwiper", {
            on: { slideChange: function() { activeIdx.value = this.activeIndex; } }
          });
        });

        return { travelData, isEditing, activeIdx, goTo, toggleEdit, loading, saveToFirebase }
      }
    }).mount('#app')
  </script>
</body>
</html>
